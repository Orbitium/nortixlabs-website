                    {t.gridEyebrow}
                </div>
                <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight font-display mb-4">
                    {t.gridTitle}
                </h2>
                <p class="text-base sm:text-lg text-slate-300">
                    {t.gridSubtitle}
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
                {/* Feature 1 */}
                <div class="group relative rounded-3xl bg-slate-900/50 border border-white/10 p-7 hover:border-cyan-500/50 hover:bg-slate-900/80 transition-all duration-300 hover:shadow-[0_15px_40px_rgba(6,182,212,0.15)] flex flex-col justify-between">
                    <div>
                        <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-blue-600 to-cyan-500 flex items-center justify-center text-white mb-5 shadow-lg shadow-blue-500/20 group-hover:scale-110 transition-transform duration-300">
                            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                            </svg>
                        </div>
                        <h3 class="text-xl font-bold text-white mb-2 font-display">{t.feature1Title}</h3>
                        <p class="text-sm text-slate-300 leading-relaxed">{t.feature1Desc}</p>
                    </div>
                </div>

                {/* Feature 2 */}
                <div class="group relative rounded-3xl bg-slate-900/50 border border-white/10 p-7 hover:border-sky-500/50 hover:bg-slate-900/80 transition-all duration-300 hover:shadow-[0_15px_40px_rgba(14,165,233,0.15)] flex flex-col justify-between">
                    <div>
                        <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-sky-500 to-blue-600 flex items-center justify-center text-white mb-5 shadow-lg shadow-sky-500/20 group-hover:scale-110 transition-transform duration-300">
                            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                            </svg>
                        </div>
                        <h3 class="text-xl font-bold text-white mb-2 font-display">{t.feature2Title}</h3>
                        <p class="text-sm text-slate-300 leading-relaxed">{t.feature2Desc}</p>
                    </div>
                </div>

                {/* Feature 3 */}
                <div class="group relative rounded-3xl bg-slate-900/50 border border-white/10 p-7 hover:border-indigo-500/50 hover:bg-slate-900/80 transition-all duration-300 hover:shadow-[0_15px_40px_rgba(99,102,241,0.15)] flex flex-col justify-between">
                    <div>
                        <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-indigo-600 to-purple-600 flex items-center justify-center text-white mb-5 shadow-lg shadow-indigo-500/20 group-hover:scale-110 transition-transform duration-300">
                            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                            </svg>
                        </div>
                        <h3 class="text-xl font-bold text-white mb-2 font-display">{t.feature3Title}</h3>
                        <p class="text-sm text-slate-300 leading-relaxed">{t.feature3Desc}</p>
                    </div>
                </div>

                {/* Feature 4 */}
                <div class="group relative rounded-3xl bg-slate-900/50 border border-white/10 p-7 hover:border-cyan-500/50 hover:bg-slate-900/80 transition-all duration-300 hover:shadow-[0_15px_40px_rgba(6,182,212,0.15)] flex flex-col justify-between">
                    <div>
                        <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-cyan-500 to-emerald-500 flex items-center justify-center text-white mb-5 shadow-lg shadow-cyan-500/20 group-hover:scale-110 transition-transform duration-300">
                            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                            </svg>
                        </div>
                        <h3 class="text-xl font-bold text-white mb-2 font-display">{t.feature4Title}</h3>
                        <p class="text-sm text-slate-300 leading-relaxed">{t.feature4Desc}</p>
                    </div>
                </div>

                {/* Feature 5 */}
                <div class="group relative rounded-3xl bg-slate-900/50 border border-white/10 p-7 hover:border-blue-500/50 hover:bg-slate-900/80 transition-all duration-300 hover:shadow-[0_15px_40px_rgba(59,130,246,0.15)] flex flex-col justify-between">
                    <div>
                        <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-blue-600 to-sky-400 flex items-center justify-center text-white mb-5 shadow-lg shadow-blue-500/20 group-hover:scale-110 transition-transform duration-300">
                            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
