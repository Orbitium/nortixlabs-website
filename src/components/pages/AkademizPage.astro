                    </div>
                </div>

                {/* Feature 6 */}
                <div class="group relative rounded-3xl bg-slate-900/50 border border-white/10 p-7 hover:border-violet-500/50 hover:bg-slate-900/80 transition-all duration-300 hover:shadow-[0_15px_40px_rgba(139,92,246,0.15)] flex flex-col justify-between">
                    <div>
                        <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-violet-600 to-indigo-500 flex items-center justify-center text-white mb-5 shadow-lg shadow-violet-500/20 group-hover:scale-110 transition-transform duration-300">
                            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                            </svg>
                        </div>
                        <h3 class="text-xl font-bold text-white mb-2 font-display">{t.feature6Title}</h3>
                        <p class="text-sm text-slate-300 leading-relaxed">{t.feature6Desc}</p>
                    </div>
                </div>
            </div>
        </section>

        {/* 5. HOW IT WORKS / STUDENT JOURNEY */}
        <section id="how-it-works" class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-20 sm:pb-32">
            <div class="text-center max-w-3xl mx-auto mb-16">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-400/20 text-cyan-400 text-xs font-bold uppercase tracking-widest mb-3">
                    {t.stepsEyebrow}
                </div>
                <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight font-display mb-4">
                    {t.stepsTitle}
                </h2>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
                {/* Connecting horizontal line on desktop */}
                <div class="hidden md:block absolute top-1/2 left-20 right-20 h-0.5 bg-gradient-to-r from-blue-600/40 via-cyan-400/40 to-blue-600/40 -translate-y-12 -z-10"></div>

                {/* Step 1 */}
                <div class="relative rounded-3xl bg-slate-900/70 border border-white/10 p-8 text-center backdrop-blur-xl">
                    <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-blue-600 to-cyan-500 text-white font-extrabold text-xl flex items-center justify-center mx-auto mb-6 shadow-lg shadow-cyan-500/25">
                        {t.step1Num}
                    </div>
                    <h3 class="text-xl font-bold text-white mb-3 font-display">{t.step1Title}</h3>
                    <p class="text-sm text-slate-300 leading-relaxed">{t.step1Desc}</p>
                </div>

                {/* Step 2 */}
                <div class="relative rounded-3xl bg-slate-900/70 border border-cyan-500/30 p-8 text-center backdrop-blur-xl shadow-[0_15px_35px_rgba(6,182,212,0.1)]">
                    <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-cyan-400 to-blue-600 text-white font-extrabold text-xl flex items-center justify-center mx-auto mb-6 shadow-lg shadow-blue-500/25">
                        {t.step2Num}
                    </div>
                    <h3 class="text-xl font-bold text-white mb-3 font-display">{t.step2Title}</h3>
                    <p class="text-sm text-slate-300 leading-relaxed">{t.step2Desc}</p>
                </div>

                {/* Step 3 */}
                <div class="relative rounded-3xl bg-slate-900/70 border border-white/10 p-8 text-center backdrop-blur-xl">
                    <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-indigo-600 to-sky-400 text-white font-extrabold text-xl flex items-center justify-center mx-auto mb-6 shadow-lg shadow-indigo-500/25">
                        {t.step3Num}
                    </div>
                    <h3 class="text-xl font-bold text-white mb-3 font-display">{t.step3Title}</h3>
                    <p class="text-sm text-slate-300 leading-relaxed">{t.step3Desc}</p>
                </div>
            </div>
        </section>

        {/* 6. COMPLETE DOWNLOAD SECTION (Included in /akademiz/ route - No redirection needed) */}
