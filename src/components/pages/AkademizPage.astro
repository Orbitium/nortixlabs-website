                <div class="relative z-10 text-center max-w-3xl mx-auto mb-12 sm:mb-16">
                    {/* Official App Icon */}
                    <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-3xl overflow-hidden mx-auto mb-6 p-[2px] bg-gradient-to-tr from-cyan-400 via-blue-500 to-indigo-500 shadow-2xl shadow-cyan-500/25">
                        <img src="/akademiz/logo.webp" alt="AkademiZ App Icon" class="w-full h-full object-cover rounded-[22px]" width="96" height="96" />
                    </div>

                    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-cyan-950/70 border border-cyan-500/40 text-cyan-300 text-xs font-bold uppercase tracking-widest mb-4 shadow-[0_0_20px_rgba(6,182,212,0.2)]">
                        <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span>
                        <span>{t.ctaEyebrow}</span>
                    </div>
                    <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight font-display mb-4">
                        {t.ctaTitle}
                    </h2>
                    <p class="text-base sm:text-lg text-slate-300 leading-relaxed">
                        {t.ctaDesc}
                    </p>
                </div>

                {/* 2-Column Store & QR Code Download Cards */}
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-10 relative z-10 max-w-4xl mx-auto">
                    
                    {/* iOS App Store Card */}
                    <div class="rounded-3xl bg-slate-950/80 border border-white/15 p-6 sm:p-8 flex flex-col items-center text-center backdrop-blur-xl hover:border-cyan-400/50 transition-all duration-300 shadow-xl group">
                        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-slate-200 text-xs font-semibold mb-5">
                            <svg class="w-4 h-4 fill-white" viewBox="0 0 24 24">
                                <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.62-.75 1.04-1.8 0.92-2.85-.9.04-2 .6-2.64 1.35-.56.65-1.06 1.72-.92 2.74 1.01.08 2.02-.49 2.64-1.24z"/>
                            </svg>
                            <span>{t.iosCardBadge}</span>
                        </div>

                        {/* High-Res QR Code */}
                        <div class="p-3 bg-white rounded-2xl w-48 h-48 flex items-center justify-center shadow-2xl mb-5 group-hover:scale-105 transition-transform duration-300">
                            <img
                                src={qrImageIos}
                                alt="AkademiZ iOS App Store QR Code"
                                width="180"
                                height="180"
                                class="w-full h-full object-contain"
                            />
                        </div>

                        <h3 class="text-lg font-bold text-white mb-1 font-display">{t.iosCardScan}</h3>
                        <p class="text-xs text-slate-400 mb-6 max-w-xs">{t.iosCardSub}</p>

                        <a
                            href={downloadUrlIos}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="w-full py-3.5 px-6 rounded-2xl bg-white hover:bg-slate-100 text-slate-950 font-bold flex items-center justify-center gap-3 shadow-lg transition-all duration-300 hover:scale-[1.02] active:scale-[0.98]"
                        >
                            <svg class="w-5 h-5 fill-slate-950" viewBox="0 0 24 24">
                                <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.62-.75 1.04-1.8 0.92-2.85-.9.04-2 .6-2.64 1.35-.56.65-1.06 1.72-.92 2.74 1.01.08 2.02-.49 2.64-1.24z"/>
                            </svg>
                            <span>{t.iosButton}</span>
                        </a>
                    </div>

                    {/* Android Google Play Card */}
                    <div class="rounded-3xl bg-slate-950/80 border border-white/15 p-6 sm:p-8 flex flex-col items-center text-center backdrop-blur-xl hover:border-blue-400/50 transition-all duration-300 shadow-xl group">
                        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/15 text-blue-300 text-xs font-semibold mb-5">
                            <svg class="w-4 h-4 fill-blue-300" viewBox="0 0 24 24">
                                <path d="M3.609 1.814L13.792 12 3.61 22.186c-.18.18-.344.153-.464.03l-.01-.01c-.12-.12-.086-.334.076-.496l9.643-9.643L3.212 2.424c-.162-.162-.196-.376-.076-.496l.01-.01c.12-.123.284-.15.464.03v-.104zm11.233 9.133l2.844-2.844-3.665-2.115-3.085 4.959 3.906 3.906c.18.18.344.153.464.03l.01-.01c.12-.12.086-.334-.076-.496l-.5-.5zM17.441 8.163l3.66 2.112c.732.423.732 1.11 0 1.533l-2.607 1.505-1.053-1.053 2.844-2.844.01-.01c.12-.12.086-.334-.076-.496l-2.778-1.747z"/>
                            </svg>
                            <span>{t.androidCardBadge}</span>
                        </div>

                        {/* High-Res QR Code */}
