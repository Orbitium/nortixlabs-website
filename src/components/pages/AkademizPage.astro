            <div class="relative rounded-3xl sm:rounded-[2.5rem] bg-gradient-to-b from-slate-900/90 via-slate-900/70 to-slate-950 border border-cyan-500/30 backdrop-blur-2xl p-8 sm:p-12 lg:p-16 overflow-hidden shadow-[0_25px_80px_rgba(2,10,30,0.8)]">
                {/* Background cosmic light blob */}
