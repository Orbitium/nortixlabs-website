---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.jsx';
import AkademizNavbar from '../akademiz/AkademizNavbar.jsx';
import AkademizHeroInteractive from '../akademiz/AkademizHeroInteractive.jsx';
import AkademizCarousel from '../akademiz/AkademizCarousel.jsx';
import { getAkademizLiveStats } from '../../lib/akademizStats';

interface Props {
    lang: 'en' | 'tr';
}

const { lang = 'tr' } = Astro.props;
const isTr = lang === 'tr';

// Fetch stats server-side (15-min edge/in-memory cache, never called from visitor PC)
const liveStats = await getAkademizLiveStats((Astro.locals as any)?.runtime?.env);

if (Astro.response?.headers) {
    Astro.response.headers.set('Cache-Control', 'public, max-age=900, s-maxage=900, stale-while-revalidate=60');
}

const formatNumber = (num: number) => {
    return isTr ? num.toLocaleString('tr-TR') : num.toLocaleString('en-US');
};

const studentsDisplay = `${formatNumber(liveStats.students)}+`;
const eventsDisplay = `${formatNumber(liveStats.events)}+`;
const postsDisplay = `${formatNumber(liveStats.communityPosts)}+`;

const downloadUrlIos = "https://apps.apple.com/tr/app/akademiz/id6762343867?l=tr";
const downloadUrlAndroid = "https://play.google.com/store/apps/details?id=me.orbitium.akademiz&pcampaignid=web_share";
const qrImageIos = "/akademiz/qr-app-store.png";
const qrImageAndroid = "/akademiz/qr-play-store.png";

const content = {
    en: {
        title: "AkademiZ - Your Campus in Your Pocket | NortixLabs",
        description: "AkademiZ is the next-gen campus super-app for university students. Real-time news, verified events, student club communities, and schedule alerts in one place.",
        heroEyebrow: "✦ THE NEXT-GEN CAMPUS SUPER-APP",
        heroLine1: "Your campus.",
        heroLine2: "In your pocket.",
        heroLine3: "AkademiZ",
        heroDesc: "University news, events, and student life — all in one place. Discover what's happening on campus, connect with student communities, and never miss a beat.",
        appStoreSub: "Download on the",
        appStoreTitle: "App Store",
        googlePlaySub: "Get it on",
        googlePlayTitle: "Google Play",
        scanQrPrompt: "Scan QR to download",
        trustBadge: "Now available for everyone on iOS & Android",

        // Stats Banner
        statStudentsCount: studentsDisplay,
        statStudentsLabel: "Active students",
        statEventsCount: eventsDisplay,
        statEventsLabel: "Published events",
        statPostsCount: postsDisplay,
        statPostsLabel: "Community posts",

        // Showcase section
        showcaseEyebrow: "ALL-IN-ONE CAMPUS PLATFORM",
        showcaseTitle: "Everything campus, one app.",
        showcaseSubtitle: "Everything you need to navigate university life, from official administrative announcements to vibrant student club gatherings.",

        // Deep Dive Feature Grid
        gridEyebrow: "ENGINEERED FOR STUDENT LIFE",
        gridTitle: "Designed for the true rhythm of campus life.",
        gridSubtitle: "No more scattered WhatsApp groups, lost bulletin board notices, or missed deadlines.",
        
        feature1Title: "Real-time Verified News",
        feature1Desc: "Aggregated announcements directly from faculties, student affairs, and official rectorate channels with zero noise.",
        
        feature2Title: "Interactive Event Calendar",
        feature2Desc: "Discover hackathons, seminars, concerts, and club meetups. One-click RSVP and instant sync with Google or Apple Calendar.",
        
        feature3Title: "Student Communities",
        feature3Desc: "Find your people among 18+ verified student clubs. Browse activities, join discussions, and collaborate on projects.",
        
        feature4Title: "Urgent Push Notifications",
        feature4Desc: "Receive critical notifications for emergency schedule changes, room shifts, and upcoming event start reminders.",
        
        feature5Title: "Campus Navigator & Venues",
        feature5Desc: "Easily locate faculty buildings, amphitheaters, cafeteria spots, and event stands across the university campus.",
        
        feature6Title: "Privacy-First Experience",
        feature6Desc: "Built with student privacy in mind. No trackers, no irrelevant ads — just clean, reliable university connectivity.",

        // Steps Section
        stepsEyebrow: "HOW IT WORKS",
        stepsTitle: "Get connected in 3 simple steps",
        step1Num: "01",
        step1Title: "Download & Open",
        step1Desc: "Install AkademiZ on your iPhone or Android device directly from your app store.",
        step2Num: "02",
        step2Title: "Select Your Faculty",
        step2Desc: "Pick your academic department and follow your favorite student clubs.",
        step3Num: "03",
        step3Title: "Live Your Campus",
        step3Desc: "Receive real-time alerts, attend vibrant events, and stay ahead of university life.",

        // Download Section
        ctaEyebrow: "DOWNLOAD NOW",
        ctaTitle: "Get AkademiZ on your phone today.",
        ctaDesc: "AkademiZ is out now for everyone. Download directly on the App Store or Google Play, or scan the QR code for your device below.",
        
        iosCardTitle: "Apple App Store",
        iosCardBadge: "iOS & iPadOS",
        iosCardScan: "Scan for iPhone / iPad",
        iosCardSub: "Scan with your camera app to download directly",
        iosButton: "Download on App Store",

        androidCardTitle: "Google Play Store",
        androidCardBadge: "Android",
        androidCardScan: "Scan for Android",
        androidCardSub: "Scan with your camera or QR reader to download",
        androidButton: "Get it on Google Play",

        ctaLiveNote: "Live for Ondokuz Mayıs University (OMÜ) and expanding to campuses worldwide.",

        // Signature
        signature: "Built for students, by students.",

        // Legal & Links Strip
        legalTitle: "Official AkademiZ Resources",
        legalPrivacy: "Privacy Policy",
        legalTerms: "Terms of Service",
        legalDelete: "Account Deletion",
        legalSupport: "Support & Contact"
    },
    tr: {
        title: "AkademiZ - Kampüsünüz Cebinizde | NortixLabs",
        description: "AkademiZ, üniversite öğrencileri için yeni nesil kampüs süper uygulamasıdır. Canlı haberler, onaylı etkinlikler, öğrenci toplulukları ve ders bildirimleri tek yerde.",
        heroEyebrow: "✦ YENİ NESİL KAMPÜS SÜPER UYGULAMASI",
        heroLine1: "Kampüsünüz.",
        heroLine2: "Cebinizde.",
        heroLine3: "AkademiZ",
        heroDesc: "Üniversite haberleri, etkinlikler ve öğrenci toplulukları — hepsi tek bir yerde. Kampüsteki gelişmeleri takip edin, kulüplerle bağlantı kurun ve kampüs yaşamını yakalayın.",
        appStoreSub: "Şuradan İndirin",
        appStoreTitle: "App Store",
        googlePlaySub: "Şuradan Edinin",
        googlePlayTitle: "Google Play",
        scanQrPrompt: "QR Kod ile İndir",
        trustBadge: "Artık iOS ve Android'de herkes için yayında",

        // Stats Banner
        statStudentsCount: studentsDisplay,
        statStudentsLabel: "Aktif öğrenci",
        statEventsCount: eventsDisplay,
        statEventsLabel: "Paylaşılan etkinlik",
        statPostsCount: postsDisplay,
        statPostsLabel: "Topluluk paylaşımı",

        // Showcase section
        showcaseEyebrow: "HEPSİ BİR ARADA KAMPÜS PLATFORMU",
        showcaseTitle: "Tüm kampüs, tek uygulama.",
        showcaseSubtitle: "Resmi akademik duyurulardan kulüp etkinliklerine kadar kampüs hayatını doyasıya yaşamanız için gereken her şey.",

        // Deep Dive Feature Grid
        gridEyebrow: "ÖĞRENCİ HAYATI İÇİN TASARLANDI",
        gridTitle: "Kampüsün gerçek ritmine göre sıfırdan üretildi.",
        gridSubtitle: "Dağınık WhatsApp gruplarına, panolarda kaybolan afişlere ve kaçırılan duyurulara veda edin.",
        
        feature1Title: "Gerçek Zamanlı Doğrulanmış Haberler",
        feature1Desc: "Fakülte, öğrenci işleri ve rektörlük duyuruları tek bir temiz akışta birleşir; bilgi kirliliği olmadan anında ulaşır.",
        
        feature2Title: "İnteraktif Etkinlik Takvimi",
        feature2Desc: "Hackathonlar, seminerler, konserler ve atölyeler tek ekranda. Tek dokunuşla katılım bildirimi ve Google/Apple takvim eşitleme.",
        
        feature3Title: "Öğrenci Toplulukları",
        feature3Desc: "18+ onaylı OMÜ öğrenci kulübünü keşfedin, üye olun, etkinlikleri ilk öğrenen siz olun ve projelerde yer alın.",
        
        feature4Title: "Anlık Push Bildirimleri",
        feature4Desc: "Acil derslik değişiklikleri, sınav tarihleri ve yaklaşan etkinlik başlangıç hatırlatıcıları doğrudan kilit ekranınıza gelsin.",
        
        feature5Title: "Kampüs Konum & Mekan Rehberi",
        feature5Desc: "Amfiler, derslikler, yemekhane noktaları ve kulüp stantlarının tam konumunu kampüs haritası üzerinden görün.",
        
        feature6Title: "Öğrenci Odaklı & Güvenli",
        feature6Desc: "Tamamen öğrenci mahremiyeti ön planda. Reklam çöplüğü yok, güvenli altyapı ve sadece üniversite odaklı içerik.",

        // Steps Section
        stepsEyebrow: "NASIL ÇALIŞIR?",
        stepsTitle: "3 kolay adımda kampüsün kalbine bağlanın",
        step1Num: "01",
        step1Title: "İndirin ve Başlatın",
        step1Desc: "AkademiZ'i App Store veya Google Play üzerinden telefonunuza hemen yükleyin.",
        step2Num: "02",
        step2Title: "Fakültenizi ve Kulüpleri Seçin",
        step2Desc: "Bölümünüzü belirleyin, ilgi duyduğunuz öğrenci kulüplerini takip listenize ekleyin.",
        step3Num: "03",
        step3Title: "Kampüsü Doyasıya Yaşayın",
        step3Desc: "Etkinlikleri kaçırmayın, anlık duyurulardan haberdar olun ve üniversite hayatınızı zenginleştirin.",

        // Download Section
        ctaEyebrow: "HEMEN İNDİRİN",
        ctaTitle: "AkademiZ'i bugün telefonunuza indirin.",
        ctaDesc: "AkademiZ artık herkes için resmi olarak yayında. Cihazınıza göre App Store veya Google Play butonuna dokunun ya da aşağıdaki QR kodları tarayın.",

        iosCardTitle: "Apple App Store",
        iosCardBadge: "iOS & iPadOS",
        iosCardScan: "iPhone / iPad için Tara",
        iosCardSub: "Kamera uygulamasıyla tarayarak doğrudan App Store'da açın",
        iosButton: "App Store'dan İndir",

        androidCardTitle: "Google Play Store",
        androidCardBadge: "Android",
        androidCardScan: "Android için Tara",
        androidCardSub: "Kameranızla tarayarak doğrudan Google Play'de açın",
        androidButton: "Google Play'den Edin",

        ctaLiveNote: "Ondokuz Mayıs Üniversitesi (OMÜ) öğrencileri için aktif kullanımda.",

        // Signature
        signature: "Öğrenciler için, öğrenciler tarafından geliştirildi.",

        // Legal & Links Strip
        legalTitle: "AkademiZ Resmi Kaynakları",
        legalPrivacy: "Gizlilik Politikası",
        legalTerms: "Kullanım Şartları",
        legalDelete: "Hesap Silme Talebi",
        legalSupport: "Destek & İletişim"
    }
};

const t = content[lang] || content.en;
const contactHref = isTr ? "/tr#contact" : "/#contact";
---

<Layout title={t.title} description={t.description} lang={lang} image="/akademiz/logo.png">
    {/* Dedicated AkademiZ Navigation */}
    <AkademizNavbar lang={lang} client:load />

    <main class="relative bg-slate-950 text-slate-100 overflow-hidden pt-24 sm:pt-28 lg:pt-32">
        {/* Background Ambient Cosmic Gradients */}
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-[650px] pointer-events-none -z-10 overflow-hidden">
            <div class="absolute -top-32 left-1/4 w-[500px] h-[500px] bg-blue-600/20 rounded-full blur-[130px]"></div>
            <div class="absolute top-20 right-10 w-[450px] h-[450px] bg-cyan-500/15 rounded-full blur-[140px]"></div>
            <div class="absolute -top-10 -left-20 w-[400px] h-[400px] bg-indigo-700/15 rounded-full blur-[120px]"></div>
            {/* Subtle high-tech grid texture */}
            <div class="absolute inset-0 bg-[linear-gradient(to_right,#1e293b0f_1px,transparent_1px),linear-gradient(to_bottom,#1e293b0f_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)]"></div>
        </div>

        {/* 1. HERO SECTION */}
        <section class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 sm:pb-24 lg:pb-32">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
                
                {/* Hero Left: Headline & Actions */}
                <div class="lg:col-span-7 space-y-6 sm:space-y-8 text-center lg:text-left">
                    
                    {/* Eyebrow Pill */}
                    <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-cyan-950/60 border border-cyan-500/30 text-cyan-300 text-xs font-semibold uppercase tracking-wider backdrop-blur-md shadow-[0_0_20px_rgba(6,182,212,0.15)]">
                        <div class="w-4 h-4 rounded overflow-hidden flex-shrink-0">
                            <img src="/akademiz/logo.webp" alt="AkademiZ Logo" class="w-full h-full object-cover" width="16" height="16" />
                        </div>
                        <span>{t.heroEyebrow}</span>
                    </div>

                    {/* Headline */}
                    <h1 class="text-4xl sm:text-6xl xl:text-7xl font-extrabold tracking-tight text-white leading-[1.08] font-display">
                        <span class="block">{t.heroLine1}</span>
                        <span class="block text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-sky-300 to-blue-400 drop-shadow-[0_0_35px_rgba(56,189,248,0.35)]">
                            {t.heroLine2}
                        </span>
                        <span class="block text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-indigo-300 to-cyan-300">
                            {t.heroLine3}
                        </span>
                    </h1>

                    {/* Subtitle */}
                    <p class="text-base sm:text-xl text-slate-300 max-w-2xl mx-auto lg:mx-0 leading-relaxed font-normal">
                        {t.heroDesc}
                    </p>

                    {/* Direct Download Badges (App Store & Google Play) */}
                    <div class="pt-2 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
                        {/* Apple App Store (Direct Link) */}
                        <a
                            href={downloadUrlIos}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="w-full sm:w-auto px-6 py-3.5 rounded-2xl bg-slate-900/90 hover:bg-slate-800/90 border border-white/15 hover:border-cyan-400/50 shadow-lg shadow-black/50 hover:shadow-cyan-500/20 flex items-center justify-center sm:justify-start gap-3.5 transition-all duration-300 hover:scale-[1.03] active:scale-[0.98] group"
                        >
                            <svg class="w-7 h-7 fill-white group-hover:scale-110 transition-transform duration-300" viewBox="0 0 24 24">
                                <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.62-.75 1.04-1.8 0.92-2.85-.9.04-2 .6-2.64 1.35-.56.65-1.06 1.72-.92 2.74 1.01.08 2.02-.49 2.64-1.24z"/>
                            </svg>
                            <div class="text-left">
                                <div class="text-[10px] uppercase font-semibold text-slate-400 tracking-wider leading-tight">{t.appStoreSub}</div>
                                <div class="text-base font-bold text-white leading-tight">{t.appStoreTitle}</div>
                            </div>
                        </a>

                        {/* Google Play (Direct Link) */}
                        <a
                            href={downloadUrlAndroid}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="w-full sm:w-auto px-6 py-3.5 rounded-2xl bg-slate-900/90 hover:bg-slate-800/90 border border-white/15 hover:border-blue-400/50 shadow-lg shadow-black/50 hover:shadow-blue-500/20 flex items-center justify-center sm:justify-start gap-3.5 transition-all duration-300 hover:scale-[1.03] active:scale-[0.98] group"
                        >
                            <svg class="w-6 h-6 fill-white group-hover:scale-110 transition-transform duration-300" viewBox="0 0 24 24">
                                <path d="M3.609 1.814L13.792 12 3.61 22.186c-.18.18-.344.153-.464.03l-.01-.01c-.12-.12-.086-.334.076-.496l9.643-9.643L3.212 2.424c-.162-.162-.196-.376-.076-.496l.01-.01c.12-.123.284-.15.464.03v-.104zm11.233 9.133l2.844-2.844-3.665-2.115-3.085 4.959 3.906 3.906c.18.18.344.153.464.03l.01-.01c.12-.12.086-.334-.076-.496l-.5-.5zM17.441 8.163l3.66 2.112c.732.423.732 1.11 0 1.533l-2.607 1.505-1.053-1.053 2.844-2.844.01-.01c.12-.12.086-.334-.076-.496l-2.778-1.747z"/>
                            </svg>
                            <div class="text-left">
                                <div class="text-[10px] uppercase font-semibold text-slate-400 tracking-wider leading-tight">{t.googlePlaySub}</div>
                                <div class="text-base font-bold text-white leading-tight">{t.googlePlayTitle}</div>
                            </div>
                        </a>

                        {/* Quick Jump to QR Codes */}
                        <a
                            href="#download"
                            class="px-4 py-3.5 rounded-2xl bg-white/[0.05] hover:bg-white/[0.1] border border-white/10 text-xs font-semibold text-slate-300 hover:text-white transition-all duration-300 flex items-center gap-2"
                        >
                            <svg class="w-4 h-4 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z" />
                            </svg>
                            <span>{t.scanQrPrompt}</span>
                        </a>
                    </div>

                    {/* Trust indicator badge */}
                    <div class="flex items-center justify-center lg:justify-start gap-2 text-xs text-slate-400 pt-1">
                        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                        <span>{t.trustBadge}</span>
                    </div>
                </div>

                {/* Hero Right: Interactive 3D Device Showcase */}
                <div class="lg:col-span-5 relative">
                    <AkademizHeroInteractive lang={lang} client:load />
                </div>
            </div>
        </section>

        {/* 2. STATS & CAMPUS HIGHLIGHTS STRIP */}
        <section id="stats" class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-20 sm:pb-28">
            <div class="relative rounded-2xl sm:rounded-3xl bg-slate-900/60 border border-cyan-500/25 backdrop-blur-xl p-6 sm:p-8 shadow-[0_20px_50px_rgba(2,12,30,0.6)]">
                {/* Subtle border glow line on top */}
                <div class="absolute top-0 left-10 right-10 h-px bg-gradient-to-r from-transparent via-cyan-400 to-transparent"></div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 sm:gap-8 items-center divide-y sm:divide-y-0 sm:divide-x divide-white/10">
                    
                    {/* Stat 1: Students */}
                    <div class="flex items-center gap-4 pt-4 sm:pt-0 pl-0 sm:pl-4 first:pt-0 first:pl-0">
                        <div class="w-12 h-12 rounded-xl bg-blue-500/15 border border-blue-400/30 flex items-center justify-center text-cyan-400 flex-shrink-0 shadow-lg shadow-blue-500/10">
                            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                            </svg>
                        </div>
                        <div>
                            <div class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight font-display">{t.statStudentsCount}</div>
                            <div class="text-xs sm:text-sm text-slate-300 font-medium">{t.statStudentsLabel}</div>
                        </div>
                    </div>

                    {/* Stat 2: Events */}
                    <div class="flex items-center gap-4 pt-4 sm:pt-0 pl-0 sm:pl-8">
                        <div class="w-12 h-12 rounded-xl bg-sky-500/15 border border-sky-400/30 flex items-center justify-center text-sky-400 flex-shrink-0 shadow-lg shadow-sky-500/10">
                            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                            </svg>
                        </div>
                        <div>
                            <div class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight font-display">{t.statEventsCount}</div>
                            <div class="text-xs sm:text-sm text-slate-300 font-medium">{t.statEventsLabel}</div>
                        </div>
                    </div>

                    {/* Stat 3: Community Posts */}
                    <div class="flex items-center gap-4 pt-4 sm:pt-0 pl-0 sm:pl-8">
                        <div class="w-12 h-12 rounded-xl bg-cyan-500/15 border border-cyan-400/30 flex items-center justify-center text-cyan-400 flex-shrink-0 shadow-lg shadow-cyan-500/10">
                            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z" />
                            </svg>
                        </div>
                        <div>
                            <div class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight font-display">{t.statPostsCount}</div>
                            <div class="text-xs sm:text-sm text-slate-300 font-medium">{t.statPostsLabel}</div>
                        </div>
                    </div>

                </div>
            </div>
        </section>

        {/* 3. SHOWCASE SECTION ("Everything campus, one app.") */}
        <section id="features" class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-20 sm:pb-32">
            {/* Section Heading */}
            <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
