---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.jsx';
import Footer from '../components/Footer.jsx';

Astro.response.status = 404;

const lang = Astro.url.pathname.startsWith('/tr') ? 'tr' : 'en';
const base = lang === 'tr' ? '/tr' : '';

const content = {
    en: {
        title: '404 - Page Not Found | NortixLabs',
        description: 'The page you requested could not be found.',
        code: '404',
        heading: 'This page does not exist.',
        body: 'The link may be broken, the page may have moved, or the address may be invalid.',
        primaryCta: 'Go Home',
        secondaryCta: 'Contact Us',
    },
    tr: {
        title: '404 - Sayfa Bulunamadi | NortixLabs',
        description: 'Istediginiz sayfa bulunamadi.',
        code: '404',
        heading: 'Bu sayfa mevcut degil.',
        body: 'Baglanti hatali olabilir, sayfa tasinmis olabilir veya adres gecersiz olabilir.',
        primaryCta: 'Ana Sayfaya Don',
        secondaryCta: 'Iletisime Gec',
    },
};

const t = content[lang];
---

<Layout title={t.title} description={t.description} lang={lang}>
    <Navbar lang={lang} client:load />

    <main class="flex min-h-screen items-center pt-28 pb-20">
        <section class="container mx-auto px-6">
            <div class="mx-auto max-w-3xl overflow-hidden rounded-[2rem] border border-white/10 bg-white/[0.03] p-8 text-center shadow-2xl shadow-cyan-950/20 md:p-12">
                <p class="text-sm font-semibold uppercase tracking-[0.28em] text-cyan-300">{t.code}</p>
                <h1 class="mt-5 text-4xl font-bold text-white md:text-6xl">{t.heading}</h1>
                <p class="mx-auto mt-5 max-w-2xl text-base leading-8 text-slate-400 md:text-lg">
                    {t.body}
                </p>

                <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
                    <a
                        href={base || '/'}
                        class="rounded-full bg-white px-7 py-3 text-sm font-bold text-slate-950 transition-all duration-300 hover:bg-cyan-300"
                    >
                        {t.primaryCta}
                    </a>
                    <a
                        href={`${base}/#contact`}
                        class="rounded-full border border-white/12 bg-white/5 px-7 py-3 text-sm font-bold text-white transition-all duration-300 hover:border-cyan-400/40 hover:bg-white/10"
                    >
                        {t.secondaryCta}
                    </a>
                </div>
            </div>
        </section>
    </main>

    <Footer lang={lang} client:visible />
</Layout>
