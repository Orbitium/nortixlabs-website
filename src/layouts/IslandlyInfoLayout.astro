---
import Layout from './Layout.astro';
import Navbar from '../components/Navbar.jsx';
import Footer from '../components/Footer.jsx';

const source = Astro.props.frontmatter ?? Astro.props;
const {
  title,
  description,
  eyebrow = 'Islandly',
  heading,
  intro,
} = source;
const currentPath = Astro.url.pathname;
---

<Layout title={title} description={description}>
  <Navbar client:load />

  <main class="pt-32 pb-24 relative z-10 min-h-screen">
    <section class="relative overflow-hidden">
      <div class="container mx-auto px-6 max-w-5xl">
        <div class="mb-8 inline-flex items-center rounded-full border border-emerald-400/20 bg-emerald-400/10 px-4 py-2 text-xs font-semibold uppercase tracking-[0.24em] text-emerald-300">
          {eyebrow}
        </div>

        <h1 class="max-w-3xl text-4xl md:text-5xl font-bold font-display text-white">
          {heading}
        </h1>

        {intro && (
          <p class="mt-5 max-w-3xl text-base md:text-lg leading-8 text-slate-300">
            {intro}
          </p>
        )}

        <nav class="mt-8 flex flex-wrap gap-3">
          <a
            href="/islandly/privacy"
            class={`rounded-full border px-4 py-2 text-sm transition-all ${
              currentPath.includes('/islandly/privacy')
                ? 'border-emerald-400/30 bg-emerald-400/10 text-emerald-300'
                : 'border-white/10 bg-white/5 text-slate-300 hover:border-white/20 hover:text-white'
            }`}
          >
            Privacy
          </a>
          <a
            href="/islandly/tos"
            class={`rounded-full border px-4 py-2 text-sm transition-all ${
              currentPath.includes('/islandly/tos')
                ? 'border-emerald-400/30 bg-emerald-400/10 text-emerald-300'
                : 'border-white/10 bg-white/5 text-slate-300 hover:border-white/20 hover:text-white'
            }`}
          >
            Terms
          </a>
          <a
            href="/islandly/account-deletion"
            class={`rounded-full border px-4 py-2 text-sm transition-all ${
              currentPath.includes('/islandly/account-deletion')
                ? 'border-emerald-400/30 bg-emerald-400/10 text-emerald-300'
                : 'border-white/10 bg-white/5 text-slate-300 hover:border-white/20 hover:text-white'
            }`}
          >
            Account Deletion
          </a>
        </nav>

        <div class="mt-10 rounded-3xl border border-white/10 bg-slate-900/70 p-8 md:p-10 shadow-2xl shadow-emerald-950/20 backdrop-blur">
          <div class="prose prose-invert prose-lg max-w-none prose-headings:font-display prose-headings:text-white prose-a:text-emerald-300 prose-strong:text-white text-slate-300">
            <slot />
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer client:visible />
</Layout>
